# =============================================
# 智能客服问答系统 环境变量模板
# 使用方法：复制本文件为 .env，填入真实值
# 注意：.env 已在 .gitignore 中，不会被提交到仓库
# =============================================

# ===== 阿里云百炼大模型 =====
# 在阿里云百炼控制台获取：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-你的百炼APIKey

# 对话模型（调试省钱可换 qwen-turbo）
LLM_MODEL=qwen-plus
# 向量化模型
EMBEDDING_MODEL=text-embedding-v3

# ===== 数据库（开发环境连接本机 MySQL）=====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=你的MySQL密码
MYSQL_DATABASE=smart_cs

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ===== JWT 认证 =====
# 随机字符串（可用 openssl rand -hex 32 生成）
JWT_SECRET=改成随机字符串
# token 有效期（分钟）
JWT_EXPIRE_MINUTES=720

# ===== 应用 =====
# 默认管理员账号（首次启动时自动创建；部署后请尽快修改默认密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# 上传文件保存目录（项目内 data 目录，D 盘）
UPLOAD_DIR=./data/uploads
# Chroma 向量库持久化目录
CHROMA_DIR=./data/chroma
